# ---------------------------------------------------------------------------
# CRA System — variáveis de ambiente
# Copie este arquivo para ".env" (local) e configure as mesmas chaves nas
# variáveis de ambiente do Netlify para deploy em produção.
# Todos os valores abaixo são fictícios/de exemplo.
# ---------------------------------------------------------------------------

# String de conexão do Supabase Postgres (Connection Pooling - porta 6543)
DATABASE_URL="postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:6543/postgres?pgbouncer=true"
# String de conexão direta (porta 5432) usada pelas migrations do Prisma
DIRECT_URL="postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres"

# Chaves do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Segredo usado para assinar os tokens JWT (gere um valor aleatório forte)
JWT_SECRET="troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres"

# URL pública da aplicação (usada em links de notificação/relatórios)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
